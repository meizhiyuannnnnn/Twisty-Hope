# 统一换行符处理
* text=auto

# 源码文件强制 LF（跨平台一致性）
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.css text eol=lf

# Windows 特有文件保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell：无 BOM + CRLF（PS 5.1 解析器在 LF 下会误判中文字符串边界）
*.ps1 text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.exe binary
*.dll binary
