# ============================================================
# 彼方希冀程序开发公司 — 根级环境变量模板
# ============================================================
# 各项目从此文件复制通用配置，再根据项目需要补充专属变量。
# 复制: cp .env.example <项目目录>/.env
# ============================================================

# ---- 应用 ----
PROJECT_NAME={{PROJECT_NAME}}
VERSION=0.1.0
DEBUG=false

# ---- 数据库 ----
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://user:CHANGE_ME@localhost:5432/app

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- 安全 ----
# ⚠️ 生产环境务必更换为随机强密码
SECRET_KEY=CHANGE_ME

# ---- CORS ----
# JSON 数组格式，生产环境填写实际域名
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- 文件存储 ----
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
