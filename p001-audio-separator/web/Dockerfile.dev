# ---- 开发阶段 Dockerfile ----
# Vite dev server with HMR, used in docker-compose development mode

FROM node:22-alpine

WORKDIR /app

# Copy package files first for layer caching
COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies for dev mode)
RUN npm ci

# Copy source code (mounted as volume in dev, but needed for initial run)
COPY . .

# Expose Vite dev server port
EXPOSE 3000

# Run Vite dev server with host binding
CMD ["npx", "vite", "--host", "0.0.0.0", "--port", "3000"]
